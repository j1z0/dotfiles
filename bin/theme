#!/usr/bin/env bash
# theme — one solarized palette, every tool, following macOS appearance.
#
# Borrowed wholesale from how Omarchy does it: don't theme each app by hand,
# keep one source of truth and fan it out. macOS appearance IS that source of
# truth here, because iTerm2 already follows it natively.
#
#   theme            show current mode
#   theme dark       go dark
#   theme light      go light
#   theme toggle     flip
#   theme apply      re-fan the current mode out to everything (idempotent)
#
# Fan-out map:
#   iterm2   native  (two colour sets per profile, "Use Separate Colors
#                      for Light and Dark Mode")
#   bat      native  (--theme=auto reads the terminal background)
#   fzf/eza/
#   starship native  (configured in ANSI colors, so the palette carries them)
#   tmux     ANSI + explicit statusline bases, refreshed here
#   neovim   auto-dark-mode.nvim, plus `background` for already-open instances
#   delta    git config --global delta.features
#   claude   ~/.claude/themes/*.json + settings.json, hot-reloaded

set -uo pipefail

STATE_DIR="$HOME/.local/state/dotfiles"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
mkdir -p "$STATE_DIR"

system_mode() {
  if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == "Dark" ]]; then
    echo dark
  else
    echo light
  fi
}

set_system_mode() {
  local want="$1" current
  current=$(system_mode)
  [[ "$want" == "$current" ]] && return 0
  osascript -e 'tell application "System Events" to tell appearance preferences to set dark mode to not dark mode' >/dev/null 2>&1
}

# --- per-tool fan-out -------------------------------------------------------

apply_shell_env() {
  local mode="$1"
  # Sourced by .zshrc at startup, and re-sourced in-place by the `theme` shell
  # function so the shell you typed this in updates too.
  cat > "$STATE_DIR/env.zsh" <<EOF
# generated by \`theme\` — do not edit
export DOTFILES_THEME_MODE="$mode"
export BAT_THEME="auto"
export BAT_THEME_DARK="Solarized (dark)"
export BAT_THEME_LIGHT="Solarized (light)"
export DELTA_FEATURES="+solarized-$mode"
EOF
}

apply_delta() {
  local mode="$1"
  git config --global delta.features "solarized-$mode"
  if [[ "$mode" == "light" ]]; then
    git config --global delta.light true
  else
    git config --global delta.light false
  fi
}

apply_tmux() {
  local mode="$1"
  tmux has-session >/dev/null 2>&1 || return 0
  tmux set-environment -g DOTFILES_THEME_MODE "$mode"
  # Solarized's ANSI map puts the status bases on different slots per mode,
  # so the statusline is the one thing tmux can't infer from the palette.
  if [[ "$mode" == "light" ]]; then
    tmux set-option -g status-style "bg=colour7,fg=colour12"
    tmux set-option -g COLORFGBG "0;15" 2>/dev/null || true
  else
    tmux set-option -g status-style "bg=colour0,fg=colour11"
    tmux set-option -g COLORFGBG "15;0" 2>/dev/null || true
  fi
  tmux list-clients -F '#{client_name}' 2>/dev/null | while read -r c; do
    tmux refresh-client -t "$c" 2>/dev/null || true
  done
}

apply_neovim() {
  local mode="$1"
  # auto-dark-mode.nvim picks this up on its own for new instances; this nudges
  # the ones already running.
  local sock
  for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*.0 /tmp/nvim.*/0; do
    [[ -S "$sock" ]] || continue
    nvim --server "$sock" --remote-send "<C-\\><C-N>:set background=$mode<CR>" >/dev/null 2>&1 || true
  done
}

apply_claude() {
  local mode="$1" src dest settings tmp
  src="$HOME/.dotfiles/claude/themes/solarized-$mode.json"
  [[ -f "$src" ]] || return 0

  # Claude Code watches ~/.claude/themes and hot-reloads, so a running session
  # retints without a restart. Both files are installed; only the pointer moves.
  mkdir -p "$CLAUDE_DIR/themes"
  for m in dark light; do
    dest="$CLAUDE_DIR/themes/solarized-$m.json"
    cp -f "$HOME/.dotfiles/claude/themes/solarized-$m.json" "$dest" 2>/dev/null || true
  done

  settings="$CLAUDE_DIR/settings.json"
  if [[ -f "$settings" ]]; then
    tmp=$(mktemp "$settings.XXXXXX")
    if jq --arg t "custom:solarized-$mode" '.theme = $t' "$settings" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$settings"
    else
      rm -f "$tmp"
    fi
  else
    mkdir -p "$CLAUDE_DIR"
    printf '{\n  "theme": "custom:solarized-%s"\n}\n' "$mode" > "$settings"
  fi
}

apply() {
  local mode="${1:-$(system_mode)}"
  echo "$mode" > "$STATE_DIR/mode"
  apply_shell_env "$mode"
  apply_delta     "$mode"
  apply_tmux      "$mode"
  apply_neovim    "$mode"
  apply_claude    "$mode"
}

# --- cli --------------------------------------------------------------------

case "${1:-status}" in
  dark|light)
    set_system_mode "$1"
    apply "$1"
    echo "theme: $1"
    ;;
  toggle)
    if [[ "$(system_mode)" == "dark" ]]; then next=light; else next=dark; fi
    set_system_mode "$next"
    apply "$next"
    echo "theme: $next"
    ;;
  apply)
    apply
    ;;
  status|"")
    echo "system:  $(system_mode)"
    echo "applied: $(cat "$STATE_DIR/mode" 2>/dev/null || echo 'never')"
    ;;
  *)
    echo "usage: theme [dark|light|toggle|apply|status]" >&2
    exit 1
    ;;
esac
